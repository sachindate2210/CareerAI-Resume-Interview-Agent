ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://careerai:careerai@postgres:5432/careerai
SYNC_DATABASE_URL=postgresql+psycopg2://careerai:careerai@postgres:5432/careerai
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# LLM provider — required for all AI features. Without a key configured for the selected
# provider, LLM calls fail gracefully with a typed AIGenerationError surfaced as a clean 5xx.
# anthropic | groq | openai | openrouter | gemini (also editable in Admin → Theme Configuration → AI Model)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Anthropic model names (LLM_PROVIDER=anthropic):
LLM_MODEL=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# Groq model names (LLM_PROVIDER=groq): LLM_MODEL=openai/gpt-oss-120b, LLM_MODEL_FAST=openai/gpt-oss-20b

# Optional — if unset, RAG falls back to a local deterministic pseudo-embedding
# (dev/offline only, logged as a warning; not real semantic search).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

MAX_UPLOAD_MB=10
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_DEFAULT=60/minute
